"""Streamlit chat UI.  Run: streamlit run app/streamlit_app.py"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

import streamlit as st

from docchat.config import DOCS_DIR
from docchat.loader import Document, load_documents
from docchat.rag import RAGPipeline

st.set_page_config(page_title="DocuChat RAG", page_icon="📚", layout="wide")
st.title("📚 Chat with your documents")


@st.cache_resource(show_spinner="Building index...")
def build_pipeline(kind: str, files: tuple):
    pipe = RAGPipeline(retriever=kind)
    docs = [Document(name, data.decode("utf-8", errors="ignore")) for name, data in files] \
        if files else load_documents(DOCS_DIR)
    pipe.ingest_documents(docs)
    return pipe, len(docs)


with st.sidebar:
    st.header("Settings")
    uploads = st.file_uploader("Upload .txt / .md files (optional)", type=["txt", "md"],
                               accept_multiple_files=True)
    kind = st.radio("Retriever", ["tfidf", "embeddings"], help="Embeddings need sentence-transformers")
    k = st.slider("Passages to retrieve", 1, 8, 4)

files = tuple((u.name, u.getvalue()) for u in uploads)
try:
    pipe, n_docs = build_pipeline(kind, files)
except ImportError as e:
    st.error(str(e))
    st.stop()

st.caption(f"{n_docs} documents indexed - answers generated by **{pipe.generator.name}**"
           + ("" if files else " (sample company handbook)"))

if "history" not in st.session_state:
    st.session_state.history = []

for role, text, hits in st.session_state.history:
    with st.chat_message(role):
        st.markdown(text)
        if hits:
            with st.expander("Sources"):
                for i, h in enumerate(hits, 1):
                    st.markdown(f"**[{i}] {h.chunk.source}** (score {h.score:.2f})")
                    st.text(h.chunk.text)

if question := st.chat_input("Ask a question about the documents"):
    ans = pipe.ask(question, k)
    st.session_state.history += [("user", question, None), ("assistant", ans.text, ans.hits)]
    st.rerun()
